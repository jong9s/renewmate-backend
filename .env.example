# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=renewmate
MYSQL_USER=renewmate
MYSQL_PASSWORD=change-me

# RenewMate JWT
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000

# Google OAuth 2.0 Web application credentials. Keep the secret out of Git.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
FRONTEND_BASE_URL=http://localhost:5173

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@renewmate.com

# Authentication token lifetimes
PASSWORD_RESET_EXPIRATION_MINUTES=30
OAUTH_EXCHANGE_CODE_EXPIRATION_SECONDS=60

# Incident reporting: 5xx errors -> GitHub repository_dispatch -> Slack alert + AI auto-fix Draft PR
# Fine-grained PAT scoped to this repository only, permission "Contents: Read and write" (required by repository_dispatch).
INCIDENT_REPORT_ENABLED=false
INCIDENT_COOLDOWN_MINUTES=30
INCIDENT_GITHUB_REPOSITORY=jong9s/renewmate-backend
INCIDENT_GITHUB_TOKEN=github_pat_replace-me
